# Server
PORT=5000
# Frontend origin allowed by CORS (optional, defaults to http://localhost:5173)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas (URI is built in src/config/db.js)
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_CLUSTER_URL=your-cluster.xxxxx.mongodb.net
DB_NAME=document_assistant

# Redis (host: redis://localhost:6379 — Docker Compose overrides to redis://redis:6379)
REDIS_URL=redis://localhost:6379

# Used by later modules
JWT_SECRET=replace_with_a_long_random_string
GEMINI_API_KEY=your_gemini_api_key
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook
