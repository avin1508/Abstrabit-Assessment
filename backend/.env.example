# Server
PORT=5000
# Frontend origin(s) allowed by CORS, comma-separated (optional, defaults to http://localhost:5173)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas (URI is built in src/config/db.js)
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_CLUSTER_URL=your-cluster.xxxxx.mongodb.net
DB_NAME=document_assistant

# Redis (host: redis://localhost:6379 — Docker Compose overrides to redis://redis:6379)
REDIS_URL=redis://localhost:6379

# Auth (required): long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Gemini (embeddings + chat) and Discord (send_summary tool) — server-side only
GEMINI_API_KEY=your_gemini_api_key
# Optional: chat model (default gemini-3.5-flash) and the minimum vector-search score (0–1)
# a chunk needs to be used as chat context; below it the assistant answers "I don't know."
GEMINI_CHAT_MODEL=gemini-3.5-flash
# Tried in order if the chat model is over quota or unavailable (each has its own free-tier quota)
GEMINI_CHAT_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite
RAG_MIN_SCORE=0.78
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
