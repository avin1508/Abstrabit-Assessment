{
  "name": "document-assistant-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the Multi-Workspace Document Assistant",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "nodemon src/server.js",
    "start:prod": "node src/server.js",
    "dev": "docker compose up",
    "dev:build": "docker compose up --build",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "dev:restart": "docker compose restart",
    "dev:logs": "docker compose logs -f",
    "dev:ps": "docker compose ps",
    "prod": "docker compose -f docker-compose.prod.yml up -d",
    "prod:build": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:restart": "docker compose -f docker-compose.prod.yml restart",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "prod:ps": "docker compose -f docker-compose.prod.yml ps"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.10",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "mongoose": "^9.10.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
